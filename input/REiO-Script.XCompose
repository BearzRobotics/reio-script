# RE_iO Script compose sequences. Install: append to ~/.XCompose (keep an include line for the system file).
# Type: Compose, then 4 keys = column-group letter a-m, column-in-group 1-7, row-group 1-7, row-in-group 1-9 (0 = 10).
# Example: Compose a 1 1 1 -> first glyph
<Multi_key> <a> <1> <1> <1> : "\U0000E000" # r01c01 attested
<Multi_key> <a> <2> <1> <1> : "\U0000E001" # r01c02 attested
